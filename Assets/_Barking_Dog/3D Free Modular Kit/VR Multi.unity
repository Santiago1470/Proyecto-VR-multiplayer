  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 44f28f086d830a846be5ff2c0971c957, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textToControl: {fileID: 1299585074}
  panelToControl: {fileID: 1705862359}
  nextPageButton: {fileID: 1668129792}
  previousPageButton: {fileID: 926665882}
  pageIndicator: {fileID: 0}
  pageContents:
  - "A los 17 a\xF1os, Dayana tom\xF3 una de las decisiones m\xE1s valientes de su
    vida: viajar sola a Estados Unidos. Al llegar a Miami, se enfrent\xF3 a enormes
    desaf\xEDos. No conoc\xEDa el idioma, deb\xEDa adaptarse a una cultura diferente
    y trabajar en lo que fuera para sobrevivir. Durante el d\xEDa estudiaba y por
    las noches trabajaba como mesera en cafeter\xEDas, enfrentando largas jornadas
    de esfuerzo y sacrificio."
  - "Caf\xE9 Virtual - #3: \xA1Atiende!\r\n\r\nObjetivo:\r\nEntrega las ordenes de
    los clientes para avanzar.\n\nMec\xE1nicas del Juego (VR):\r\nExisten dos pedidos,
    caf\xE9 y donas, las donas tendras que entregarlas tal cual, mientras que el
    caf\xE9 debera ser llenado en la maquina de caf\xE9."
  playerHead: {fileID: 0}
  fadeDuration: 0.3
  useDistanceCheck: 1
  triggerDistance: 2
